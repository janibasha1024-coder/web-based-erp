@model Invoice
@{
    ViewData["Title"] = Model.Number;
    ViewData["Nav"] = "invoices";
}

<div class="toolbar">
    <a href="/Invoices">All invoices</a>
    <a class="button" href="/Invoices/Edit/@Model.Id">Edit</a>
</div>

<section class="panel detail-grid">
    <div>
        <span>Customer</span>
        <strong><a href="/Customers/Details/@Model.CustomerId">@Model.Customer?.Name</a></strong>
    </div>
    <div>
        <span>Issued</span>
        <strong>@Model.IssueDate.ToString("MMM d, yyyy")</strong>
    </div>
    <div>
        <span>Due</span>
        <strong>@Model.DueDate.ToString("MMM d, yyyy")</strong>
    </div>
    <div>
        <span>Status</span>
        <strong><span class="badge badge-@Model.Status.ToLowerInvariant()">@Model.Status</span></strong>
    </div>
    <div>
        <span>Total</span>
        <strong>@Totals.For(Model).ToString("C")</strong>
    </div>
</section>

<section class="panel">
    <div class="panel-head">
        <h2>Lines</h2>
    </div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Description</th>
                    <th class="num">Qty</th>
                    <th class="num">Unit price</th>
                    <th class="num">Amount</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var line in Model.Lines)
            {
                <tr>
                    <td>@line.Description</td>
                    <td class="num">@line.Quantity.ToString("0.##")</td>
                    <td class="num">@line.UnitPrice.ToString("C")</td>
                    <td class="num">@Totals.Amount(line.Quantity, line.UnitPrice).ToString("C")</td>
                </tr>
            }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3">Total</th>
                    <th class="num">@Totals.For(Model).ToString("C")</th>
                </tr>
            </tfoot>
        </table>
    </div>
</section>
