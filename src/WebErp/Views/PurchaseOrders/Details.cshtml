@model PurchaseOrder
@{
    ViewData["Title"] = Model.Number;
    ViewData["Nav"] = "orders";
}

<div class="toolbar">
    <a href="/PurchaseOrders">All purchase orders</a>
    <a class="button" href="/PurchaseOrders/Edit/@Model.Id">Edit</a>
</div>

<section class="panel detail-grid">
    <div>
        <span>Vendor</span>
        <strong><a href="/Vendors/Details/@Model.VendorId">@Model.Vendor?.Name</a></strong>
    </div>
    <div>
        <span>Ordered</span>
        <strong>@Model.OrderDate.ToString("MMM d, yyyy")</strong>
    </div>
    <div>
        <span>Expected</span>
        <strong>@Model.ExpectedDate.ToString("MMM d, yyyy")</strong>
    </div>
    <div>
        <span>Status</span>
        <strong><span class="badge badge-@Model.Status.ToLowerInvariant()">@Model.Status</span></strong>
    </div>
    <div>
        <span>Total</span>
        <strong>@Totals.For(Model).ToString("C")</strong>
    </div>
</section>

<section class="panel">
    <div class="panel-head">
        <h2>Lines</h2>
    </div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Description</th>
                    <th class="num">Qty</th>
                    <th class="num">Unit price</th>
                    <th class="num">Amount</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var line in Model.Lines)
            {
                <tr>
                    <td>@line.Description</td>
                    <td class="num">@line.Quantity.ToString("0.##")</td>
                    <td class="num">@line.UnitPrice.ToString("C")</td>
                    <td class="num">@Totals.Amount(line.Quantity, line.UnitPrice).ToString("C")</td>
                </tr>
            }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3">Total</th>
                    <th class="num">@Totals.For(Model).ToString("C")</th>
                </tr>
            </tfoot>
        </table>
    </div>
</section>
